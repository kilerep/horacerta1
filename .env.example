ALLOWED_HOSTS=horacertagestao.com.br,www.horacertagestao.com.br,3.128.144.176,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://horacertagestao.com.br,https://www.horacertagestao.com.br,http://3.128.144.176,http://localhost:8000,http://127.0.0.1:8000

# Database
# Em producao (Render), use uma DATABASE_URL do PostgreSQL
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Logging / alertas de erro em produção
# Formato: "Nome:email@dominio.com,Outro Nome:outro@dominio.com"
ADMINS=

# Caminho do admin do Django. Deixe em branco para manter "admin/" (padrão),
# ou defina algo não óbvio (sem espaços/barras) para reduzir varredura de bots,
# ex.: ADMIN_URL_PATH=gestao-interna-x7f
# Atenção: mudar isso muda a URL que a equipe usa pra logar no admin.
ADMIN_URL_PATH=

# Email
USE_CONSOLE_EMAIL=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_TLS=
EMAIL_USE_SSL=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
